# 公共环境变量
# 以 NEXT_PUBLIC_ 开头

# 项目名称
NEXT_PUBLIC_APP_NAME=燕 桥 中 学 Ai Agent

# 当前客户端的 host
NEXT_PUBLIC_CLIENT_HOST=http://127.0.0.1:3000

# 后端 API 接口地址
NEXT_PUBLIC_API_BASE_URL=/api/v1

# 后端 API 接口代理目标地址
NEXT_PUBLIC_API_PROXY_TARGIT_URL=http://127.0.0.1:9002/api/v1

#Core服务 目标地址
NEXT_PUBLIC_CORE_API_TARGIT_URL=http://127.0.0.1:9001/api/v1

# streamChat SSE 接口地址
NEXT_PUBLIC_STREAM_CHAT_API_URL=http://127.0.0.1:9002/api/v1/chat/stream